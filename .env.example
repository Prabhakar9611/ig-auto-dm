# Copy this file's contents into Vercel's Environment Variables dashboard.
# Never commit a real .env file with real values to GitHub.

# A random string YOU make up — used only during the Meta webhook handshake.
IG_VERIFY_TOKEN=choose-any-random-string-123

# From Meta App Dashboard > your Page > Generate Token (long-lived Page Access Token)
IG_PAGE_ACCESS_TOKEN=

# Comma-separated, case-insensitive. Only comments containing one of these trigger the DM flow.
IG_TRIGGER_KEYWORDS=job

# Your Instagram profile URL — used for the "Visit Profile" button.
IG_PROFILE_URL=https://instagram.com/your_username

# Your WhatsApp channel invite link — sent to people who tap "Not Yet".
IG_WHATSAPP_CHANNEL_LINK=https://whatsapp.com/channel/your-channel-id

# Your YouTube channel or video link — also sent to people who tap "Not Yet".
IG_YOUTUBE_LINK=https://youtube.com/@your-channel

# Fallback job message for any Reel NOT listed in lib/reelConfig.js,
# sent to people who tap "I'm Following ✅".
IG_DM_MESSAGE=Thanks for following! Check out our open roles here: https://example.com/careers
